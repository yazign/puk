<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Perdezh" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/pink</item>
        <item name="colorPrimaryDark">@color/purple</item>
        <item name="colorAccent">@color/yellow</item>
        <item name="android:windowBackground">@color/purple</item>
        <item name="android:statusBarColor">@color/purple</item>
        <item name="android:navigationBarColor">@color/purple</item>
    </style>

    <style name="Pixel">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="ArcadeButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
