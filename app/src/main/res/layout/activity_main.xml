<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple">

    <!-- ЭКРАН 1: СТАРТ -->
        <LinearLayout
            android:id="@+id/screenStart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Pixel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:shadowColor="@color/dark"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="0.01"
                android:text="@string/title_top"
                android:textColor="@color/cyan"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:rotation="-3"
                android:shadowColor="@color/pink"
                android:shadowDx="8"
                android:shadowDy="8"
                android:shadowRadius="0.01"
                android:text="@string/title_big"
                android:textColor="@color/yellow"
                android:textSize="52sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="22dp"
                android:layout_weight="1"
                android:background="@drawable/bg_shadow_round"
                android:minHeight="240dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/photoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_photo"
                    android:foreground="@drawable/fg_photo_stroke">

                    <ImageView
                        android:id="@+id/photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:id="@+id/photoHint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="160dp"
                            android:layout_height="123dp"
                            android:contentDescription="@null"
                            android:src="@drawable/mascot" />

                        <TextView
                            style="@style/Pixel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/photo_hint"
                            android:textColor="@color/purple"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <Button
                android:id="@+id/btnPhoto"
                style="@style/ArcadeButton"
                android:background="@drawable/bg_btn_pink"
                android:text="@string/btn_photo"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnWhich"
                style="@style/ArcadeButton"
                android:background="@drawable/bg_btn_yellow"
                android:visibility="gone"
                android:text="@string/btn_which"
                android:textColor="@color/dark" />
        </LinearLayout>

    <!-- ЭКРАН 2: ЗАГРУЗКА -->
    <ScrollView
        android:id="@+id/screenLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Pixel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:shadowColor="@color/dark"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="0.01"
                android:text="@string/loading_title"
                android:textColor="@color/yellow"
                android:textSize="22sp" />

            <FrameLayout
                android:id="@+id/loadingCircle"
                android:layout_width="260dp"
                android:layout_height="268dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_circle"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/loadingMascot"
                    android:layout_width="200dp"
                    android:layout_height="154dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/mascot_puff" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/loadingBlocks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_track"
                android:orientation="horizontal"
                android:padding="7dp" />

            <TextView
                android:id="@+id/loadingPercent"
                style="@style/Pixel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="0%"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_tip"
                android:fontFamily="sans-serif-black"
                android:paddingLeft="20dp"
                android:paddingTop="12dp"
                android:paddingRight="20dp"
                android:paddingBottom="18dp"
                android:rotation="-2"
                android:text="@string/loading_tip"
                android:textColor="@color/dark"
                android:textSize="18sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:background="@drawable/bg_outline"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ЭКРАН 3: РЕЗУЛЬТАТ -->
    <ScrollView
        android:id="@+id/screenResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Pixel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:shadowColor="@color/dark"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="0.01"
                android:text="@string/result_title"
                android:textColor="@color/cyan"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/resultName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_burst"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:minHeight="150dp"
                android:paddingLeft="20dp"
                android:paddingTop="20dp"
                android:paddingRight="28dp"
                android:paddingBottom="28dp"
                android:rotation="-3"
                android:textAllCaps="true"
                android:textColor="@color/dark"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="14dp"
                android:paddingRight="18dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Pixel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/power"
                        android:textColor="@color/dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/powerLabel"
                        style="@style/Pixel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E11D74"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/powerBlocks"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/resultDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/dark"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="108dp"
                android:layout_height="116dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_play"
                android:contentDescription="@string/play"
                android:paddingBottom="8dp"
                android:src="@drawable/ic_play"
                android:stateListAnimator="@null" />

            <TextView
                style="@style/Pixel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tap_to_listen"
                android:textColor="@color/yellow"
                android:textSize="13sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnShare"
                    style="@style/ArcadeButton"
                    android:layout_width="0dp"
                    android:layout_marginRight="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_pink"
                    android:text="@string/btn_share"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnAgain"
                    style="@style/ArcadeButton"
                    android:layout_width="0dp"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_cyan"
                    android:text="@string/btn_again"
                    android:textColor="@color/dark"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
